# Dedicated mailbox for the agent (never the personal inbox).
AGENT_EMAIL=jobs-agent@example.com
AGENT_EMAIL_IMAP_HOST=imap.example.com
AGENT_EMAIL_IMAP_PORT=993
AGENT_EMAIL_IMAP_USERNAME=jobs-agent@example.com
AGENT_EMAIL_IMAP_PASSWORD=
AGENT_EMAIL_SMTP_HOST=smtp.example.com
AGENT_EMAIL_SMTP_PORT=587
AGENT_EMAIL_SMTP_USERNAME=jobs-agent@example.com
AGENT_EMAIL_SMTP_PASSWORD=

# LLM — Gemini Flash is primary, Groq is rate-limit fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=you@example.com

# Calendar (Google Calendar is optional; local SQLite calendar works without it)
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CREDENTIALS_FILE=/app/secrets/google-calendar.json

# Runtime
AUTOAPPLY_DRY_RUN=true
AUTOAPPLY_KILL_SWITCH=false
AUTOAPPLY_TIMEZONE=America/Argentina/Buenos_Aires
MATCH_THRESHOLD=0.72
MAX_APPLIES_PER_DAY=10
POLL_INTERVAL_SECONDS=900
SQLITE_PATH=data/autoapply.db
HEARTBEAT_INTERVAL_HOURS=24
HEARTBEAT_STALE_AFTER_HOURS=26
