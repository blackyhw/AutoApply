[Unit]
Description=AutoApply job agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autoapply
WorkingDirectory=/opt/autoapply
EnvironmentFile=/opt/autoapply/.env
ExecStart=/opt/autoapply/.venv/bin/python -m autoapply run
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
